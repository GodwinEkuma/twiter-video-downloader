{
  "manifest_version": 2,
  "name": "Twitter Video Downloader",
  "description": "For downloading videos from twitter web.",
  "version": "1.0.0",
  "permissions": [
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://*.twimg.com/*",
    "cookies",
    "storage",
    "downloads",
    "tabs",
    "clipboard"
  ],
  "icons": {
    "16": "/images/favicon-16x16.png",
    "32": "/images/favicon-32x32.png",
    "96": "/images/favicon-96x96.png",
    "256": "/images/favicon-256x256.png"
  },
  "browser_action": {
    "default_title": "Twitter Video Downloader",
    "default_icon": {
      "16": "/images/favicon-16x16.png",
      "32": "/images/favicon-32x32.png",
      "96": "/images/favicon-96x96.png",
      "256": "/images/favicon-256x256.png"
    },
    "default_popup": "/index.html"
  },
  "background": {
    "scripts": ["/static/js/0.chunk.js", "/static/js/background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://*.twimg.com/*"
      ],
      "js": ["/static/js/0.chunk.js", "/static/js/content.js"]
    }
  ],
  "content_security_policy": "script-src 'self' 'sha256-qAcmzXQ8jmB7ddF3B7OWAJKIn2C00zGiCGj8W5dG+wo='; object-src 'self'"
}
